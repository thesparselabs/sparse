# Copy to .env.local and fill in. Works with any Postgres, including Neon and Supabase.
#
# Neon:     Dashboard > Connect > copy the *pooled* connection string
#           (the host contains "-pooler").
# Supabase: Project Settings > Database > Connection string > "Transaction pooler".
#
# Not wired up yet: the ideas list and form run on placeholder data while the
# front end is built. Kept here, with db/schema.sql, for when the backend lands.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Optional. /open-source reads public repo data from the GitHub API, which
# allows 60 unauthenticated requests an hour per IP. Results are cached for an
# hour, so that is usually plenty; a fine-grained token with no extra
# permissions lifts the limit if a shared host IP runs into it.
# GITHUB_TOKEN=
